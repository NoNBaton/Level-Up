generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id           String   @id @default(uuid())
  nickname     String   @unique
  passwordHash String
  level        Int      @default(1)
  xp           Int      @default(0)
  rank         String   @default("E-РАНГ")
  createdAt    DateTime @default(now())
}